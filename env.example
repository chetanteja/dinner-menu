# Copy to .env.local for local dev. On Vercel, add these in Project -> Settings -> Environment Variables.
# Without SUPABASE_* locally, the app falls back to a JSON file in .data/ (dev only).

SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Any long random string:  openssl rand -base64 32
SESSION_SECRET=
CRON_SECRET=

# Push notifications (optional):  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional (default Asia/Kolkata)
DEFAULT_TIMEZONE=Asia/Kolkata
